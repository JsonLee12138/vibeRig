{
  "name": "vibe-rig",
  "type": "module",
  "version": "1.2.1",
  "packageManager": "pnpm@9.15.9",
  "description": "Goal-driven software-development harness with confirmed requirements, continuous execution, evidence, and human acceptance.",
  "license": "MIT",
  "homepage": "https://github.com/JsonLee12138/vibeRig#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/JsonLee12138/vibeRig.git"
  },
  "bugs": {
    "url": "https://github.com/JsonLee12138/vibeRig/issues"
  },
  "keywords": [
    "pi-package",
    "software-development",
    "subagents",
    "plane"
  ],
  "bin": {
    "viberig": "./dist/cli/index.js",
    "vb": "./dist/cli/index.js",
    "vibe-rig": "./dist/cli/index.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "dist",
    "pi",
    "skills"
  ],
  "pi": {
    "extensions": [
      "./dist/pi/company.js",
      "./node_modules/@tintinweb/pi-subagents/src/index.ts"
    ],
    "skills": [
      "./skills/vb-init",
      "./skills/vb-company",
      "./skills/vb-wiki"
    ]
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/cli/index.ts",
    "lint": "eslint src scripts/*.mjs eslint.config.js tsdown.config.ts package.json tsconfig.json .github/workflows/*.yml",
    "lint:fix": "eslint src scripts/*.mjs eslint.config.js tsdown.config.ts package.json tsconfig.json .github/workflows/*.yml --fix",
    "typecheck": "tsc --noEmit",
    "test:pi-company": "node scripts/validate-pi-company.mjs",
    "test:pi-development-ab": "node scripts/validate-pi-development-ab.mjs",
    "test:pi-package-load": "node scripts/validate-pi-package-load.mjs",
    "eval:pi-company-ab": "node scripts/run-pi-company-ab.mjs",
    "eval:pi-council-ab": "node scripts/run-pi-council-ab.mjs",
    "eval:pi-development-ab": "node scripts/run-pi-development-ab.mjs",
    "test": "pnpm run typecheck && pnpm run test:pi-company && pnpm run test:pi-development-ab"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.0",
    "@earendil-works/pi-coding-agent": ">=0.80.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@tintinweb/pi-subagents": "0.14.3",
    "citty": "^0.1.6",
    "consola": "^3.4.2",
    "fs-extra": "^11.3.0",
    "pi-mcp-adapter": "2.15.0",
    "yaml": "2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.0.10",
    "eslint": "^10.6.0",
    "eslint-plugin-format": "^2.0.1",
    "tsdown": "^0.13.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "bundledDependencies": [
    "@tintinweb/pi-subagents",
    "pi-mcp-adapter"
  ]
}
