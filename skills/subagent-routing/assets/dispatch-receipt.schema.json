{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viberig.dev/schemas/dispatch-receipt.schema.json",
  "title": "VibeRig Subagent Dispatch Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dispatchId",
    "routeId",
    "invocationId",
    "phase",
    "capability",
    "agent",
    "objectiveFingerprint",
    "artifactFingerprint",
    "oracleFingerprint",
    "independenceRequired",
    "startedAt",
    "completedAt",
    "status",
    "verdict",
    "outputRef",
    "outputDigest",
    "artifactRefs"
  ],
  "properties": {
    "dispatchId": {
      "type": "string",
      "pattern": "^dispatch:[a-zA-Z0-9._-]+:[a-f0-9]{64}$"
    },
    "routeId": {
      "type": "string",
      "pattern": "^route:[a-zA-Z0-9._-]+:[a-f0-9]{64}$"
    },
    "invocationId": { "type": "string", "minLength": 1 },
    "phase": { "enum": ["research", "white_team", "red_team", "implementation", "review", "qa", "security", "integration"] },
    "focus": { "type": ["string", "null"] },
    "capability": { "type": "string", "minLength": 1 },
    "agent": { "type": "string", "minLength": 1 },
    "objectiveFingerprint": { "type": "string", "minLength": 1 },
    "artifactFingerprint": { "type": "string", "minLength": 1 },
    "oracleFingerprint": { "type": "string", "minLength": 1 },
    "independenceRequired": { "type": "boolean" },
    "independentFrom": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "status": { "enum": ["dispatched", "completed", "failed", "blocked", "cancelled"] },
    "verdict": { "type": ["string", "null"] },
    "outputRef": { "type": ["string", "null"] },
    "outputDigest": { "type": ["string", "null"] },
    "failureClass": { "type": ["string", "null"] },
    "fallbackReason": { "type": ["string", "null"] },
    "artifactRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
