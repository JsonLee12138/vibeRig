{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://viberig.dev/schemas/e2e-contract.schema.json",
  "title": "VibeRig E2E Test Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "requirementId", "contracts"],
  "properties": {
    "version": { "const": 1 },
    "requirementId": { "type": "string", "minLength": 1 },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "title", "type", "scope", "acIds", "preconditions", "steps", "expected",
          "requiredFidelity", "environment", "testPath", "status", "contractRevision",
          "oracleApproval", "implementationReview", "lock", "redEvidenceRef", "passingEvidenceRef",
          "invalidatedBy", "backendExecution"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^E2E-[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "type": { "enum": ["api_e2e", "ui_e2e"] },
          "scope": { "enum": ["issue_local", "milestone"] },
          "acIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^AC-[0-9]+$" } },
          "preconditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "expected": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "requiredFidelity": { "enum": ["ephemeral", "sandbox", "real", "real_browser"] },
          "environment": { "type": "string", "minLength": 1 },
          "testPath": { "type": ["string", "null"] },
          "status": { "enum": ["drafted", "red_verified", "locked", "passing", "invalidated"] },
          "contractRevision": { "type": "integer", "minimum": 1 },
          "oracleApproval": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "source", "approvedRevision"],
            "properties": {
              "status": { "enum": ["pending", "approved", "rejected"] },
              "source": { "enum": ["requirement_gate", "owner_review"] },
              "approvedRevision": { "type": ["integer", "null"], "minimum": 1 }
            }
          },
          "implementationReview": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "reviewerKind", "reviewedRevision"],
            "properties": {
              "status": { "enum": ["pending", "approved", "changes_requested"] },
              "reviewerKind": { "enum": ["independent_qa", "technical_owner", "product_owner"] },
              "reviewedRevision": { "type": ["integer", "null"], "minimum": 1 }
            }
          },
          "lock": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "lockedRevision", "changePolicy"],
            "properties": {
              "status": { "enum": ["unlocked", "locked", "superseded"] },
              "lockedRevision": { "type": ["integer", "null"], "minimum": 1 },
              "changePolicy": { "const": "reopen_contract_review" }
            }
          },
          "redEvidenceRef": { "type": ["string", "null"] },
          "passingEvidenceRef": { "type": ["string", "null"] },
          "invalidatedBy": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "backendExecution": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": [
              "boundary", "transport", "sutRuntime", "ownedDependencies", "externalDependencyPolicy",
              "isolation", "commands", "assertionKinds", "negativePathKinds", "asyncWait",
              "artifactKinds", "repositoryGrounding"
            ],
            "properties": {
              "boundary": { "const": "public_protocol_to_owned_state" },
              "transport": { "enum": ["http", "grpc", "graphql", "message"] },
              "sutRuntime": { "const": "declared_runtime" },
              "ownedDependencies": {
                "type": "array",
                "uniqueItems": true,
                "items": { "enum": ["database", "cache", "broker", "object_store"] }
              },
              "externalDependencyPolicy": { "enum": ["real_sandbox", "protocol_fake_at_boundary", "not_applicable"] },
              "isolation": { "const": "unique_namespace_and_reset" },
              "commands": {
                "type": "object",
                "additionalProperties": false,
                "required": ["bootstrap", "health", "test", "reset"],
                "properties": {
                  "bootstrap": { "type": "string", "minLength": 1 },
                  "health": { "type": "string", "minLength": 1 },
                  "test": { "type": "string", "minLength": 1 },
                  "reset": { "type": "string", "minLength": 1 }
                }
              },
              "assertionKinds": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": { "enum": ["response", "durable_state", "side_effect", "absence", "authorization_boundary"] }
              },
              "negativePathKinds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["authentication", "authorization", "validation", "tenant_isolation", "idempotency", "rollback", "concurrency"] }
              },
              "asyncWait": { "enum": ["bounded_polling", "not_applicable"] },
              "artifactKinds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["test_report", "service_logs", "protocol_trace", "database_snapshot", "message_trace"] }
              },
              "repositoryGrounding": {
                "type": "object",
                "additionalProperties": false,
                "required": ["testFramework", "configPath", "discoveryCommand", "collectionEvidenceRef", "testFileHash"],
                "properties": {
                  "testFramework": { "type": "string", "minLength": 1 },
                  "configPath": { "type": "string", "minLength": 1 },
                  "discoveryCommand": { "type": "string", "minLength": 1 },
                  "collectionEvidenceRef": { "type": ["string", "null"] },
                  "testFileHash": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "enum": ["red_verified", "locked", "passing"] } } },
            "then": {
              "properties": {
                "testPath": { "type": "string", "minLength": 1 },
                "redEvidenceRef": { "type": "string", "minLength": 1 }
              }
            }
          },
          {
            "if": { "properties": { "status": { "enum": ["locked", "passing"] } } },
            "then": {
              "properties": {
                "oracleApproval": { "properties": { "status": { "const": "approved" }, "approvedRevision": { "type": "integer", "minimum": 1 } } },
                "implementationReview": { "properties": { "status": { "const": "approved" }, "reviewedRevision": { "type": "integer", "minimum": 1 } } },
                "lock": { "properties": { "status": { "const": "locked" }, "lockedRevision": { "type": "integer", "minimum": 1 } } }
              }
            }
          },
          {
            "if": { "properties": { "status": { "const": "passing" } } },
            "then": { "properties": { "passingEvidenceRef": { "type": "string", "minLength": 1 } } }
          },
          {
            "if": { "properties": { "type": { "const": "api_e2e" } } },
            "then": { "properties": { "backendExecution": { "type": "object" } } },
            "else": { "properties": { "backendExecution": { "type": "null" } } }
          },
          {
            "if": {
              "properties": {
                "type": { "const": "api_e2e" },
                "status": { "enum": ["locked", "passing"] }
              }
            },
            "then": {
              "properties": {
                "backendExecution": {
                  "properties": {
                    "repositoryGrounding": {
                      "properties": {
                        "collectionEvidenceRef": { "type": "string", "minLength": 1 },
                        "testFileHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
