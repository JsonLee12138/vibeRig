{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://viberig.dev/schemas/delivery-plan.schema.json",
  "title": "VibeRig Delivery Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "requirementId", "revision", "planFingerprint", "status", "milestones"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "requirementId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "planFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": {
      "enum": [
        "local_draft",
        "sync_pending",
        "pending_plan_confirmation",
        "approved",
        "conditional",
        "rejected"
      ]
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "acIds", "linearId", "state", "issues"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "acIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^AC-[0-9]+$" }
          },
          "linearId": { "type": ["string", "null"] },
          "state": {
            "enum": ["draft", "sync_pending", "pending_plan_confirmation", "ready_for_development", "superseded"]
          },
          "issues": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "acIds",
                "testCaseIds",
                "riskIds",
                "dependencies",
                "indicative",
                "linearId",
                "state"
              ],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 },
                "acIds": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "pattern": "^AC-[0-9]+$" }
                },
                "testCaseIds": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "riskIds": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "dependencies": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "indicative": { "type": "boolean" },
                "linearId": { "type": ["string", "null"] },
                "state": {
                  "enum": [
                    "draft",
                    "sync_pending",
                    "pending_plan_confirmation",
                    "ready_for_development",
                    "superseded"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
