{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://viberig.dev/schemas/requirement.schema.json",
  "title": "VibeRig Requirement Traceability (requirement.yaml)",
  "type": "object",
  "required": ["version", "requirement", "milestones"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "version": { "const": 2 }
        }
      },
      "then": {
        "properties": {
          "requirement": {
            "required": ["planning"],
            "properties": {
              "planning": {
                "required": [
                  "prd_decision",
                  "prd_reason",
                  "owner_approval",
                  "approved_at",
                  "plan_approval",
                  "plan_approved_at",
                  "plan_fingerprint",
                  "linear_draft_synced_at"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [1, 2],
      "description": "v1 只有需求基线 owner_approval；v2 将计划确认拆为独立 plan_approval"
    },
    "requirement": {
      "type": "object",
      "required": ["id", "title", "status", "prd", "created"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "语义 slug（全小写 kebab-case，如 payment-refactor）；兼容历史 req-NNNN",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "title": { "type": "string" },
        "status": {
          "type": "string",
          "enum": [
            "intake",
            "requirement_baselined",
            "pre_development",
            "pre_development_blocked",
            "plan_draft_sync",
            "awaiting_plan_confirmation",
            "awaiting_owner_approval",
            "conditionally_approved",
            "ready_for_development",
            "planned",
            "in_progress",
            "accepted",
            "archived"
          ]
        },
        "prd": {
          "type": ["string", "null"],
          "description": "关联 PRD id；无 PRD 或尚未完成自动判断时为 null",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "created": { "type": "string", "format": "date" },
        "planning": {
          "type": "object",
          "required": ["prd_decision", "prd_reason", "owner_approval", "approved_at"],
          "additionalProperties": false,
          "properties": {
            "prd_decision": { "type": "string", "enum": ["pending", "existing", "create", "not_required"] },
            "prd_reason": { "type": ["string", "null"] },
            "owner_approval": { "type": "string", "enum": ["pending", "approved", "conditional", "rejected"] },
            "approved_at": { "type": ["string", "null"], "format": "date-time" },
            "plan_approval": {
              "type": "string",
              "description": "Milestone / Issue Linear 草案的独立人工确认状态；不替代需求基线确认",
              "enum": ["not_required", "pending", "approved", "conditional", "rejected"]
            },
            "plan_approved_at": { "type": ["string", "null"], "format": "date-time" },
            "plan_fingerprint": {
              "type": ["string", "null"],
              "description": "写入 Linear 并提交人工确认的计划内容摘要"
            },
            "linear_draft_synced_at": { "type": ["string", "null"], "format": "date-time" }
          }
        }
      }
    },
    "milestones": {
      "type": "array",
      "description": "开发前先作为不可执行草案写入 Linear；人工确认计划后才进入 ready_for_development",
      "items": {
        "type": "object",
        "required": ["id", "linear_id", "title", "module", "ac_ids", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^(ms-[0-9]+|M[0-9]+)$" },
          "linear_id": { "type": ["string", "null"] },
          "title": { "type": "string" },
          "module": { "type": "string", "description": "兼容字段；填写主要交付域，不作为里程碑切分依据" },
          "ac_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^AC-[0-9]+$" }
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "sync_pending",
              "pending_plan_confirmation",
              "ready_for_development",
              "not_started",
              "in_progress",
              "pending_acceptance",
              "accepted",
              "superseded"
            ]
          }
        }
      }
    }
  }
}
